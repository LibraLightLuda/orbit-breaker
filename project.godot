; Orbit Breaker - single-player survival MVP
config_version=5

[application]
config/name="Orbit Breaker · 오빗 브레이커"
config/use_custom_user_dir=true
config/custom_user_dir_name="OrbitBreaker"
run/main_scene="res://main.tscn"
run/main_scene.dedicated_server="res://server/empty.tscn"
run/main_loop_type.dedicated_server="OrbitMatchServer"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="5분 돌파 이후에도 계속되는 한계 생존. 붕괴하는 우주에서 최대 10분까지."
config/icon="res://icon.svg"
boot_splash/image="res://assets/branding/splash.png"
boot_splash/bg_color=Color(0.0196, 0.0471, 0.0863, 1)
boot_splash/show_image=true
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027, 0.047, 0.075, 1)

[audio]
driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true
